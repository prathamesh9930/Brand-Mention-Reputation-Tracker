# Production Environment Configuration
# COPY THIS TO .env AND UPDATE WITH YOUR REAL VALUES

# ==============================================
# 🔐 CRITICAL SECURITY SETTINGS - CHANGE ALL!
# ==============================================

# JWT Secret - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secure-jwt-secret-key-change-this-immediately

# API Keys for different access levels
ADMIN_API_KEY=admin_live_key_12345abcdef67890ghijklmnop
CLIENT_API_KEY=client_live_key_98765zyxwvu43210fedcba
NEWS_API_KEY=your_actual_news_api_key_from_newsapi_org

# ==============================================
# 🗄️ DATABASE CONFIGURATION
# ==============================================

# Production PostgreSQL (change credentials!)
DATABASE_URL=postgresql://brand_user:secure_db_password@localhost:5432/brand_tracker_prod

# Development SQLite (for local testing)
# DATABASE_URL=sqlite:///./brand_tracker_dev.db

# ==============================================
# 📦 REDIS CONFIGURATION
# ==============================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here

# ==============================================
# 🌐 APPLICATION SETTINGS
# ==============================================

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# CORS origins (add your production domains)
CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com", "https://api.yourdomain.com"]

# ==============================================
# 🔒 SSL/HTTPS CONFIGURATION
# ==============================================

# Enable HTTPS in production
FORCE_HTTPS=true

# SSL certificate paths (for self-hosted)
SSL_CERT_PATH=/path/to/your/certificate.crt
SSL_KEY_PATH=/path/to/your/private.key

# ==============================================
# 📡 EXTERNAL API CONFIGURATIONS
# ==============================================

# News API (get from https://newsapi.org/)
NEWS_API_BASE_URL=https://newsapi.org/v2

# Social Media APIs (optional)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ==============================================
# 🚨 MONITORING & ALERTING
# ==============================================

# Email settings for alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
ADMIN_EMAIL=admin@yourdomain.com

# Webhook for notifications
WEBHOOK_URL=https://hooks.slack.com/your/webhook/url

# ==============================================
# ⚡ PERFORMANCE & SCALING
# ==============================================

# Rate limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Cache settings
CACHE_TTL=3600
CACHE_PREFIX=brand_tracker_

# ==============================================
# 🏷️ APPLICATION METADATA
# ==============================================

APP_NAME=Brand Tracker
APP_VERSION=1.0.0
APP_DESCRIPTION=Professional Brand Mention & Reputation Tracking System

# ==============================================
# QUICK SETUP INSTRUCTIONS:
# ==============================================
# 
# 1. Copy this file to .env
# 2. Generate secure secrets:
#    python -c "import secrets; print('SECRET_KEY=' + secrets.token_urlsafe(32))"
#    python -c "import secrets; print('ADMIN_API_KEY=admin_' + secrets.token_urlsafe(16))"
#    python -c "import secrets; print('CLIENT_API_KEY=client_' + secrets.token_urlsafe(16))"
# 
# 3. Get real API keys:
#    - News API: https://newsapi.org/register
#    - Twitter API: https://developer.twitter.com/
# 
# 4. Set up your database:
#    - Install PostgreSQL
#    - Create database: brand_tracker_prod
#    - Update DATABASE_URL with real credentials
# 
# 5. Configure your domains in CORS_ORIGINS
# 
# 6. For production deployment:
#    - Set ENVIRONMENT=production
#    - Set FORCE_HTTPS=true
#    - Configure SSL certificates
#    - Set up monitoring email/webhooks
# 
# ⚠️  NEVER commit .env file to version control!
# ⚠️  Always use strong, unique passwords!
# ⚠️  Regularly rotate your API keys!
# ==============================================